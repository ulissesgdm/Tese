Eseb1 <- Eseb1 %>%
  mutate(raca = case_when(D12A %in% Outros ~ "Outros",
                          D12A == "Preto" ~ "Preto",
                          D12A == "Pardo" ~ "Pardo",
                          D12A == "Branco" ~ "Branco"))


##########################################################################################################


reg_milico1 <- glm(Q31_14 ~ Q02f*Q10P2b + Q01 + D09_RENDAF + D01A_IDADE + D02 + REG + D03 + religiao + raca, data = Eseb1, family = binomial)

summary(reg_milico1)

Eseb1$predicted_prob <- predict(reg_milico1, type = "response")


ggplot(Eseb1, aes(x = Q02f, y = predicted_prob, color = Q10P2b)) +
  geom_point(alpha = 0.5) +
  geom_smooth(method = "glm", method.args = list(family = "binomial"), se = FALSE, aes(linetype = Q10P2b)) +
  labs(title = "Consumo de Redes Sociais e apoio a educação militar nas escolas públicas",
       x = "Dias de consumo - Redes Sociais",
       y = "Tendência a discordância",
       color = "Voto",
       linetype = "Voto") +
  theme_minimal()


