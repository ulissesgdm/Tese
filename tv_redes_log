########################################################################################


#Regressões e gráficos sobre o consumo de mídias e a renda

#Maioridade e TV

###################################################################################

#Tratamento

Eseb1 <- select(ESEB2022, SbjNum, D01A_IDADE, Q01, Q03, Q02b, Q02f, D02, D03, REG, Q02a, Q02g, Q07d, Q07j, Q07e, Q07f, Q10P1b, Q10P2b, D10, D09_RENDAF, D12a, Q19, Q29, Q31_1, Q31_2, Q31_3, Q31_4, Q31_5, Q31_6, Q31_7, Q31_8, Q31_9, Q31_10, Q31_11, Q31_12, Q31_13, Q31_14)


# Filtragem de entrevistados que não responderam as variáveis utilizadas na pesquisa

Eseb1 <- Eseb1 %>% filter(Q02b < 90, Q02f < 90,  D03 < 90, Q31_1 <3,
                          D09_RENDAF < 200000, D03 < 11, D12a < 90, Q10P2b < 40) %>%
  mutate(D10 = as_factor(D10),
         D12A = as_factor(D12a),
         Q31_1 = as_factor(Q31_1),
         REG = as_factor(REG),
         Q10P2b = as_factor(Q10P2b),
         D02 = as_factor(D02),
         Q01 = as_factor(Q01))

#Variável Voto


Eseb1 <- Eseb1 %>%
  mutate(Q10P2b = case_when(#Q10P2b == "Anulou o Voto" ~ "Branco/Nulo",
    #Q10P2b == "Votou em branco" ~ "Branco/Nulo",
    #Q10P2b == "Não Sabe/Não lembra" ~ "Não sabe/Não respondeu",
    #Q10P2b == "Não respondeu" ~ "Não sabe/Não respondeu",
    Q10P2b == "Lula" ~ "Lula",
    Q10P2b == "Jair Bolsonaro" ~ "Jair Bolsonaro",
  ))


#Variável religião

Outras <- levels(Eseb1$D10)[-c(3,5,96,97,98)]

Eseb1 <- Eseb1 %>%
  mutate(religiao = case_when(D10 %in% Outras ~ "Outras",
                              D10 == "Católica" ~ "Católica",
                              D10 == "Evangélica" ~ "Evangélica",
                              D10 == "Não tem religião" ~ "Não tem religião",
                              D10 == "É ATEU/AGNÓSTICO/ NÃO ACREDITA EM DEUS " ~ "Não tem religião"))


#Variável Raça

Outros <- levels(Eseb1$D12A)[c(4,5, 97, 98)]

Eseb1 <- Eseb1 %>%
  mutate(raca = case_when(D12A %in% Outros ~ "Outros",
                          D12A == "Preto" ~ "Preto",
                          D12A == "Pardo" ~ "Pardo",
                          D12A == "Branco" ~ "Branco"))

##########################################################################################################

reg_maioridade <- glm(Q31_1 ~ Q02b*Q10P2b + Q01 + D09_RENDAF + D01A_IDADE + D02 + REG + D03 + religiao + raca, data = Eseb1, family = binomial)

summary(reg_maioridade)

Eseb1$predicted_prob <- predict(reg_maioridade, type = "response")


ggplot(Eseb1, aes(x = Q02b, y = predicted_prob, color = Q10P2b)) +
  geom_point(alpha = 0.5) +
  geom_smooth(method = "glm", method.args = list(family = "binomial"), se = FALSE, aes(linetype = Q10P2b)) +
  labs(title = "Consumo de TV e apoio à red. da maioridade",
       x = "Tendência a discordar",
       y = "Probabilidade Predita",
       color = "Voto",
       linetype = "Voto") +
  theme_minimal()

